{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "hfpc",
    "compatibility_date": "2026-09-17",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": ".output/server/index.mjs",
    "assets": {
        "binding": "ASSETS",
        "directory": ".output/public"
    },
    "build": {
        "command": "npm run build"
    },
    "observability": {
        "enabled": true
    }
}